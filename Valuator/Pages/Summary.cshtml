@page
@model Valuator.Pages.SummaryModel
@{
}
<div>
    <p>Плагиат: @Model.Similarity</p>
    <p>
        Оценка содержания:
        <span id="rankContainer">
            @if (Model.Rank.HasValue)
            {
                <span>@Model.Rank.Value</span>
            }
            else
            {
                <span id="calculationStatus">Обработка не завершена...</span>
            }
        </span>
    </p>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const textId = '@Model.Id';
    const statusElement = document.getElementById("calculationStatus");

    console.log(textId);

    if (statusElement) {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/resultHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connection.on("ReceiveRank", function (rankValue)
        {
            document.getElementById("rankContainer").innerText = rankValue.toFixed(2);
        });

        connection.start().then(function ()
        {
            connection.invoke("JoinTextGroup", textId).catch(function (err)
            {
                return console.error(err.toString());
            });
        })
        .catch(function (err)
        {
            return console.error(err.toString());
        });
    }

</script>