@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}
<div style="text-align: right; margin-bottom: 20px;">
    <span>Вы вошли как: <b>@User.Identity?.Name</b></span>

    <form method="post" asp-page-handler="Logout" style="display: inline-block; margin-left: 10px;">
        <button type="submit">Выйти</button>
    </form>
</div>

<div class="text-center">
    <form method="post">
        <div class="col-2">Текст для оценки:</div>
        <div class="col-10">
            <textarea name="text" rows="5" cols="50"></textarea>
            <input type="submit" />
        </div>
    </form>
</div>